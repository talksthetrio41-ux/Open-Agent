# Qwen account (filled from the GUI login screen)
QWEN_USERNAME=""
QWEN_PASSWORD=""
QWEN_TOKEN=""
QWEN_COOKIE=""

# GitHub workspace (files live in this repo)
GITHUB_TOKEN=""
GITHUB_REPO=""

# Server
HOST=0.0.0.0
PORT=8765

# Optional: lock the public Cloudflare tunnel with this PIN
# (auto-generated on first launch if empty)
OPEN_AGENT_PIN=""

# Optional: path to system Chromium (Termux sets this automatically)
# CHROMIUM_PATH=/data/data/com.termux/files/usr/bin/chromium-browser
#
# Browser backend: cdp | playwright
# Android/Termux always uses CDP (Playwright has no Android wheels).
# OPEN_AGENT_BROWSER=cdp
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
